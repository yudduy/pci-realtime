# PCI Real-Time Monitor — environment variables
# Copy this file to `.env` and fill in real values; `.env` is gitignored.

# ─── LLM providers (Phase 2 scoring) ────────────────────────────────────────
# OpenAI: used for Stage-1 screening (gpt-4.1-mini) and optional Stage-2 scoring (gpt-4.1).
OPENAI_API_KEY=sk-...

# Anthropic: alternative for Stage-2 scoring (claude-sonnet-4.5 / claude-opus-4.x).
ANTHROPIC_API_KEY=sk-ant-...

# ─── Government data sources (Phase 1 ingestion) ────────────────────────────
# ProPublica Congress API — free, register at https://www.propublica.org/datastore/api/propublica-congress-api
PROPUBLICA_CONGRESS_API_KEY=...

# Optional: GovInfo API key (for fallback Congressional Record access).
# Free, register at https://api.govinfo.gov/signup/
GOVINFO_API_KEY=

# Optional: Federal Register API does not require a key as of 2026, but a User-Agent is required.
# Set a contact email for politeness.
FEDERAL_REGISTER_USER_AGENT=pci-realtime/0.1 (yikaicao@stanford.edu)

# ─── Cost guardrails ────────────────────────────────────────────────────────
# Hard ceiling per single LLM run, in USD. The scorer aborts if estimated
# cost exceeds this without an explicit --confirm-cost flag.
PCI_LLM_RUN_COST_CEILING_USD=50

# ─── Storage paths (override only if you know what you're doing) ────────────
# Defaults are set in pci_realtime/config.py and resolve relative to repo root.
# PCI_DATA_RAW_DIR=data/raw
# PCI_DATA_PROCESSED_DIR=data/processed
# PCI_DATA_CACHE_DIR=data/cache
