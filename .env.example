# PCI Real-Time Monitor — environment variables
# Copy this file to `.env` and fill in real values; `.env` is gitignored.

# ─── LLM providers ──────────────────────────────────────────────────────────
# Default cascade: OpenAI nano for screening, mini for scoring, 5.5 for audits.
OPENAI_API_KEY=sk-...

# Provider/model routing. Override these when benchmarking providers.
PCI_LLM_PROVIDER=openai
PCI_SCREENING_PROVIDER=openai
PCI_SCREENING_MODEL=gpt-5.4-nano
PCI_SCORING_PROVIDER=openai
PCI_SCORING_MODEL=gpt-5.4-mini
PCI_AUDIT_PROVIDER=openai
PCI_AUDIT_MODEL=gpt-5.5

# Research providers
PCI_RESEARCH_PROVIDERS=parallel,openai
PCI_RESEARCH_RUN_COST_CEILING_USD=2
PCI_RESEARCH_MAX_REQUESTS_PER_RUN=25
PCI_RESEARCH_MAX_PROMOTIONS_PER_LANE=3
PARALLEL_API_KEY=
EXA_API_KEY=
# Parallel base is $0.01/run; use core at $0.025 for deeper sweeps.
PCI_PARALLEL_PROCESSOR=base

# ─── Government data sources ────────────────────────────────────────────────
# Congress.gov API — primary legislative source, free api.data.gov key.
CONGRESS_GOV_API_KEY=

# ProPublica Congress API — optional fallback only.
PROPUBLICA_CONGRESS_API_KEY=

# GovInfo API key for canonical federal package/text metadata.
# Free, register at https://api.govinfo.gov/signup/
GOVINFO_API_KEY=

# Regulations.gov API key for dockets, comments, and rulemaking documents.
REGULATIONS_GOV_API_KEY=

# FRED API key for macro context series.
FRED_API_KEY=

# Optional context sources.
EIA_API_KEY=
COURTLISTENER_API_TOKEN=

# Optional: Federal Register API does not require a key as of 2026, but a User-Agent is required.
# Set a reachable contact (email or project URL) for politeness.
FEDERAL_REGISTER_USER_AGENT=pci-realtime/0.1 (+https://pcindex.vercel.app)

# ─── Cost guardrails ────────────────────────────────────────────────────────
# Hard ceiling per single LLM run, in USD. The scorer aborts if estimated
# cost exceeds this without an explicit --confirm-cost flag.
PCI_LLM_RUN_COST_CEILING_USD=50

# ─── Supabase registry backend ──────────────────────────────────────────────
# Frontends read only public views with the publishable key. Server-side
# pipeline jobs require the service-role key and must never expose it to
# browsers or client logs.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CLI provisioning helpers. `SUPABASE_PROJECT_REF` links an existing project.
# To create one from CLI, set SUPABASE_ORG_ID and SUPABASE_DB_PASSWORD instead.
SUPABASE_PROJECT_REF=
SUPABASE_ORG_ID=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_NAME=pci-realtime
SUPABASE_REGION=us-west-1

# Vercel CLI deployment for apps/web.
VERCEL_PROJECT_NAME=pcindex
PRODUCTION_URL=https://pcindex.vercel.app
# Optional when your account has multiple scopes/teams.
VERCEL_SCOPE=

# Supabase Edge Functions only trigger external Python workflows. They do not
# run pandas/parquet/scoring directly. The trigger secret is required for
# inbound calls to the public Edge Function.
PYTHON_PIPELINE_WEBHOOK_URL=
PYTHON_PIPELINE_WEBHOOK_SECRET=
PYTHON_PIPELINE_TRIGGER_SECRET=

# ─── Private Kalshi execution (disabled by default) ─────────────────────────
# Public Kalshi market-data reads do not require credentials. Live execution is
# gated and requires explicit human approval.
PCI_ENABLE_LIVE_TRADING=false
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# Alternative to KALSHI_PRIVATE_KEY_PATH. Prefer the path locally.
KALSHI_PRIVATE_KEY=

# ─── Storage paths (override only if you know what you're doing) ────────────
# Defaults are set in pci_realtime/config.py and resolve relative to repo root.
# PCI_DATA_RAW_DIR=data/raw
# PCI_DATA_PROCESSED_DIR=data/processed
# PCI_DATA_CACHE_DIR=data/cache
